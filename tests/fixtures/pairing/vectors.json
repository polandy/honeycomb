      "pictures": [
        { "folder": "/P", "raw": null, "rendered": "/P/A.JPG", "sidecars": [], "ambiguous": false }
      ]
    },
    {
      "name": "in separate subfolders the RAW and the rendered subfolder pair as their parent folder",
      "source": "Q16",
      "sharedWithFramehive": false,
      "settings": { "folderMode": { "kind": "separate-subfolders", "rawSubfolder": "RAW", "renderedSubfolder": "JPG" } },
