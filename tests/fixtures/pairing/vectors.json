      ]
    },
    {
      "name": "an extension added to the rendered list pairs",
      "source": "Q15",
      "sharedWithFramehive": true,
      "settings": { "renderedExtensions": ["jpg", "jpeg", "heic", "heif", "hif", "tif", "tiff"] },
