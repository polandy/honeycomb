{
  "config": {
    "default": true,
    "MD013": { "line_length": 100, "tables": false, "code_blocks": false },
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", "vendor/**", "CHANGELOG.md", "LICENSE", "LICENSES/**"]
}
