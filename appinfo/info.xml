<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>honeycomb</id>
	<name>honeycomb</name>
	<summary>Cull RAW+JPEG photo pairs, touch-first for the iPad</summary>
	<description><![CDATA[A photo shot as RAW+JPEG is two files with the same base name; honeycomb treats them as one picture. Look at it once, rate, label, pick or reject it once, and delete both files and their XMP sidecars together into the trash bin.]]></description>
	<version>0.0.0</version>
	<licence>agpl</licence>
	<author>Andy Pollari</author>
	<namespace>Honeycomb</namespace>
	<category>multimedia</category>
	<website>https://github.com/polandy/honeycomb</website>
	<bugs>https://github.com/polandy/honeycomb/issues</bugs>
	<repository type="git">https://github.com/polandy/honeycomb.git</repository>
	<dependencies>
		<php min-version="8.3"/>
		<nextcloud min-version="35" max-version="35"/>
	</dependencies>
