<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>honeycomb</id>
	<name>honeycomb</name>
	<summary>Cull RAW+JPEG photo pairs, made for desktop and tablet</summary>
	<description><![CDATA[A photo shot as RAW+JPEG is two files with the same base name; honeycomb treats them as one picture. Look at it once, rate, label, pick or reject it once, and delete both files and their XMP sidecars together into the trash bin.]]></description>
	<version>0.1.3</version>
	<licence>agpl</licence>
	<author>Andy Pollari</author>
	<namespace>Honeycomb</namespace>
	<documentation>
		<user>https://github.com/polandy/honeycomb/blob/main/docs/user/README.md</user>
		<admin>https://github.com/polandy/honeycomb/blob/main/docs/user/admin/README.md</admin>
		<developer>https://github.com/polandy/honeycomb/blob/main/docs/dev/README.md</developer>
	</documentation>
	<category>multimedia</category>
	<website>https://github.com/polandy/honeycomb</website>
	<bugs>https://github.com/polandy/honeycomb/issues</bugs>
	<repository type="git">https://github.com/polandy/honeycomb.git</repository>
	<screenshot>https://raw.githubusercontent.com/polandy/honeycomb-assets/main/ux-review-2026-11/grid-ipad-land-light.png</screenshot>
	<screenshot>https://raw.githubusercontent.com/polandy/honeycomb-assets/main/ux-review-2026-11/loupe-ipad-land-light.png</screenshot>
	<screenshot>https://raw.githubusercontent.com/polandy/honeycomb-assets/main/ux-review-2026-11/series-compare-ipad-port-light.png</screenshot>
	<dependencies>
		<php min-version="8.3"/>
		<nextcloud min-version="35" max-version="35"/>
	</dependencies>
	<background-jobs>
		<job>OCA\Honeycomb\BackgroundJob\SweepVanishedRows</job>
	</background-jobs>
	<repair-steps>
		<pre-migration>
			<step>OCA\Honeycomb\Migration\ReinstallBeforeBaseline</step>
		</pre-migration>
	</repair-steps>
	<commands>
		<command>OCA\Honeycomb\Command\ClearCache</command>
		<command>OCA\Honeycomb\Command\Cleanup</command>
		<command>OCA\Honeycomb\Command\JobsStatus</command>
		<command>OCA\Honeycomb\Command\StatsReset</command>
	</commands>
	<navigations>
		<navigation>
			<id>honeycomb</id>
			<name>honeycomb</name>
			<route>honeycomb.page.index</route>
			<icon>app.svg</icon>
			<type>link</type>
		</navigation>
	</navigations>
</info>
