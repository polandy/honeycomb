<psalm
	errorLevel="1"
	findUnusedBaselineEntry="true"
	findUnusedCode="true"
	phpVersion="8.3"
	resolveFromConfigFile="true"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="https://getpsalm.org/schema/config"
	xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
	<projectFiles>
		<directory name="lib"/>
		<directory name="templates"/>
		<directory name="tests/php"/>
	</projectFiles>
	<!-- Files go through OCP\Files (CLAUDE.md rule 1); time, randomness and output through injected OCP services. -->
	<forbiddenFunctions>
		<function name="var_dump"/>
		<function name="print_r"/>
		<function name="error_log"/>
		<function name="sleep"/>
		<function name="usleep"/>
		<function name="time"/>
		<function name="microtime"/>
		<function name="date"/>
		<function name="rand"/>
		<function name="mt_rand"/>
		<function name="random_int"/>
		<function name="uniqid"/>
		<function name="fopen"/>
		<function name="file_get_contents"/>
		<function name="file_put_contents"/>
		<function name="file_exists"/>
		<function name="unlink"/>
		<function name="rename"/>
		<function name="copy"/>
		<function name="mkdir"/>
		<function name="rmdir"/>
		<function name="scandir"/>
		<function name="glob"/>
		<function name="exec"/>
		<function name="shell_exec"/>
		<function name="system"/>
		<function name="passthru"/>
		<function name="proc_open"/>
	</forbiddenFunctions>
	<!-- Psalm reports the closures of the inherited OCP Controller constructor. -->
	<issueHandlers>
		<InvalidTemplateParam>
			<errorLevel type="suppress">
				<directory name="vendor"/>
			</errorLevel>
		</InvalidTemplateParam>
		<MissingClosureParamType>
			<errorLevel type="suppress">
				<directory name="vendor"/>
			</errorLevel>
		</MissingClosureParamType>
		<MissingClosureReturnType>
			<errorLevel type="suppress">
				<directory name="vendor"/>
			</errorLevel>
		</MissingClosureReturnType>
		<!-- OCP's TTransactional refers to server classes the stubs lack. -->
		<UndefinedClass>
			<errorLevel type="suppress">
				<file name="vendor/nextcloud/ocp/OCP/AppFramework/Db/TTransactional.php"/>
			</errorLevel>
		</UndefinedClass>
		<UndefinedFunction>
			<errorLevel type="suppress">
				<file name="vendor/nextcloud/ocp/OCP/AppFramework/Db/TTransactional.php"/>
			</errorLevel>
		</UndefinedFunction>
		<InvalidThrow>
			<errorLevel type="suppress">
				<file name="vendor/nextcloud/ocp/OCP/AppFramework/Db/TTransactional.php"/>
			</errorLevel>
		</InvalidThrow>
		<MixedMethodCall>
			<errorLevel type="suppress">
				<file name="vendor/nextcloud/ocp/OCP/AppFramework/Db/TTransactional.php"/>
			</errorLevel>
		</MixedMethodCall>
		<MixedArgument>
			<errorLevel type="suppress">
				<directory name="vendor"/>
			</errorLevel>
		</MixedArgument>
	</issueHandlers>
</psalm>
