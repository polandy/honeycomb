{
	"name": "polandy/honeycomb",
	"description": "Cull RAW+JPEG photo pairs in Nextcloud, touch-first for the iPad",
	"license": "AGPL-3.0-or-later",
	"type": "project",
	"require": {
		"php": ">=8.3 <8.6"
	},
	"require-dev": {
		"nextcloud/coding-standard": "1.5.0",
		"nextcloud/ocp": "dev-stable35",
		"phpunit/phpunit": "12.5.43",
		"vimeo/psalm": "7.2.0"
	},
	"autoload": {
		"psr-4": {
			"OCA\\Honeycomb\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\Honeycomb\\Tests\\": "tests/php/",
			"OCP\\": "vendor/nextcloud/ocp/OCP/"
		}
	},
	"scripts": {
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --no-cache --threads=1",
		"test": "phpunit"
	},
	"config": {
		"optimize-autoloader": true,
		"platform": {
			"php": "8.3.16"
		},
		"sort-packages": true
	}
}
